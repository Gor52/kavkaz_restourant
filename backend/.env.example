DATABASE_URL="postgresql://user:pass@localhost:5432/kavkaz_restourant"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Почта для уведомлений (восстановление пароля, регистрация, создание заказа).
# Режим log — код только в консоли сервера, без SMTP.
# MAIL_MODE=log
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kavkaz Restaurant <noreply@example.com>"
