// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id_user       Int      @id @default(autoincrement())
  role_id       Int      @default(1) // 1 - User, 2 - Manager, 3 - Admin
  full_name     String
  phone         String   @unique
  email         String?
  password_hash String
  is_blocked    Boolean  @default(false)
  registered_at DateTime @default(now()) @db.Timestamp(6)

  // Relations
  orders       Order[]
  bookings     Booking[]
  reviews      Review[]
  addresses    Address[]
  bonusHistory BonusOperation[]
  carts        Cart[]
  notifications Notification[]

  @@map("users")
}

model Category {
  id_category Int     @id @default(autoincrement())
  title       String
  sort_order  Int     @default(0)

  // Relations
  dishes Dish[]

  @@map("categories")
}

model Dish {
  id_dish      Int      @id @default(autoincrement())
  category_id  Int
  title        String
  description  String
  ingredients  String
  price        Decimal  @db.Decimal(10, 2)
  weight       Int
  calories     Int?
  allergens    String?
  photo_path   String?
  is_available Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp(6)

  // Relations
  category    Category     @relation(fields: [category_id], references: [id_category])
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@map("dishes")
}

model Cart {
  id_cart   Int        @id @default(autoincrement())
  user_id   Int
  created_at DateTime   @default(now()) @db.Timestamp(6)

  // Relations
  user      User       @relation(fields: [user_id], references: [id_user])
  cartItems CartItem[]

  @@map("carts")
}

model CartItem {
  id_cart_item    Int      @id @default(autoincrement())
  cart_id         Int
  dish_id         Int
  quantity        Int
  comment         String?
  selected_options String?
  created_at      DateTime @default(now()) @db.Timestamp(6)

  // Relations
  cart Cart @relation(fields: [cart_id], references: [id_cart])
  dish Dish @relation(fields: [dish_id], references: [id_dish])

  @@map("cart_items")
}

model Order {
  id_order           Int       @id @default(autoincrement())
  user_id            Int
  address_id         Int?
  order_status_id    Int       @default(1)
  pickup_type_id     Int
  payment_method_id  Int
  receive_time       DateTime  @db.Timestamp(6)
  comment            String?
  total_amount       Decimal   @db.Decimal(10, 2)
  spent_bonus        Int       @default(0)
  created_at         DateTime  @default(now()) @db.Timestamp(6)

  // Relations
  user           User         @relation(fields: [user_id], references: [id_user])
  address        Address?     @relation(fields: [address_id], references: [id_address])
  orderItems     OrderItem[]
  bonusOperation BonusOperation[]

  @@map("orders")
}

model OrderItem {
  id_order_item   Int     @id @default(autoincrement())
  order_id        Int
  dish_id         Int?
  quantity        Int
  price_at_order_time Decimal @db.Decimal(10, 2)
  item_total      Decimal @db.Decimal(10, 2)
  selected_options String?
  dish_title      String?
  dish_photo      String?

  // Relations
  order Order @relation(fields: [order_id], references: [id_order])
  dish  Dish?  @relation(fields: [dish_id], references: [id_dish])

  @@map("order_items")
}

model Booking {
  id_booking          Int      @id @default(autoincrement())
  user_id             Int
  booking_date        DateTime @db.Date
  booking_time        String
  guest_count         Int
  comment             String?
  booking_status_id   Int      @default(1)
  created_at          DateTime @default(now()) @db.Timestamp(6)

  // Relations
  user User @relation(fields: [user_id], references: [id_user])

  @@map("bookings")
}

model Review {
  id_review    Int      @id @default(autoincrement())
  user_id      Int
  dish_id      Int
  rating       Int
  review_text  String
  published_at DateTime @default(now()) @db.Timestamp(6)

  // Relations
  user User @relation(fields: [user_id], references: [id_user])
  dish Dish @relation(fields: [dish_id], references: [id_dish])

  @@map("reviews")
}

model Notification {
  id_notification Int      @id @default(autoincrement())
  user_id         Int
  title           String
  text            String
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamp(6)

  // Relations
  user User @relation(fields: [user_id], references: [id_user])

  @@map("notifications")
}

model Address {
  id_address  Int      @id @default(autoincrement())
  user_id     Int
  address_text String
  comment     String?
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamp(6)

  // Relations
  user   User    @relation(fields: [user_id], references: [id_user])
  orders Order[]

  @@map("addresses")
}

model BonusOperation {
  id_bonus_operation     Int      @id @default(autoincrement())
  user_id                Int
  bonus_operation_type_id Int
  bonus_amount           Int
  order_id               Int?
  created_at             DateTime @default(now()) @db.Timestamp(6)

  // Relations
  user  User  @relation(fields: [user_id], references: [id_user])
  order Order? @relation(fields: [order_id], references: [id_order])

  @@map("bonus_operations")
}